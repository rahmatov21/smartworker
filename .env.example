# OpenRouter API Configuration for Autonomous Self-Improving Agent
# Primary/Default Key
OPENROUTER_API_KEY=sk-or-v1-primary-key-here

# Secondary/Fallback Keys (System will automatically rotate if rate-limited or exhausted)
OPENROUTER_API_KEY_1=sk-or-v1-fallback-key-1
OPENROUTER_API_KEY_2=sk-or-v1-fallback-key-2
OPENROUTER_API_KEY_3=sk-or-v1-fallback-key-3
OPENROUTER_API_KEY_4=sk-or-v1-fallback-key-4

# Model Selection (e.g., qwen/qwen-2.5-72b-instruct, qwen/qwen-2.5-coder-32b-instruct, or custom)
OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct

# OpenRouter Base URL
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Simulation / Mock Mode (set to true to run offline tests without consuming API credits)
MOCK_LLM=false
